{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::infs3701-team-artifacts-214018170594/releases/*"
      ],
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::214018170594:role/LabRole"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}
