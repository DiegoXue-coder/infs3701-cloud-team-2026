        <mxCell id="c59" value="Native metrics*" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;fontColor=#7A3E9D;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
