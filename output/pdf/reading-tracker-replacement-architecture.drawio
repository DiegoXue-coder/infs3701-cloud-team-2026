        </mxCell>
        <mxCell id="c69" value="&lt;b&gt;SECURITY BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;div&gt;ALB: internet ingress :80; egress :8000 to private subnets.&lt;/div&gt;&lt;div&gt;App: ingress :8000 from ALB SG; egress :443 to service prefix lists.&lt;/div&gt;&lt;div&gt;Private hosts use IMDSv2 and course LabRole. Public and ALB-to-app HTTP are unencrypted.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#C9D3DC;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="884" width="518" height="168" as="geometry" />
        </mxCell>
        <mxCell id="c70" value="&lt;b&gt;AVAILABILITY AND SCALING&lt;/b&gt;&lt;br&gt;&lt;div&gt;Two stateless app hosts across two AZs share DynamoDB.&lt;/div&gt;&lt;div&gt;The ALB health check tests the application process.&lt;/div&gt;&lt;div&gt;Capacity can grow by registering additional hosts.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#C9D3DC;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="568" y="884" width="518" height="168" as="geometry" />
        </mxCell>
        <mxCell id="c71" value="&lt;b&gt;EVIDENCE AND SCOPE&lt;/b&gt;&lt;br&gt;&lt;div&gt;Configuration shown is from the replacement Lab template.&lt;/div&gt;&lt;div&gt;Confirm actual AZs, targets and dashboard against T26 outputs before submission.&lt;/div&gt;&lt;div&gt;The demonstration uses fictional data.&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#C9D3DC;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1106" y="884" width="518" height="168" as="geometry" />
